# ------------------------------------
# 1. DEPENDENCIES & BUILD ARTIFACTS
# ------------------------------------
# Node dependencies
/node_modules
node_modules


# Distribution and build directories
/dist
/build
/out

# Log files
npm-debug.log*
yarn-debug.log*
.log
*.log

# ------------------------------------
# 2. ENVIRONMENT AND SECRETS
# ------------------------------------
# Critical: Do not commit sensitive environment variables!
.env
.env.*
.env.local

# ------------------------------------
# 3. DATABASE FILES (Local/Temp)
# ------------------------------------
# Ignoring potential local SQLite files
# (Even though moved to Supabase, good to ignore)
/backend/db/*.sqlite
/backend/db/*.sqlite-journal
*.db

# ------------------------------------
# 4. OS AND EDITOR FILES
# ------------------------------------
# macOS files
.DS_Store

# Windows files
Thumbs.db

# VS Code directory (optional, remove if sharing settings)
.vscode/

# Other common editor files (e.g., Vim swap files)
*.swp
*~